<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by CycleView.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cyc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cyc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Next in Cycle"
            android:textColor="@color/widget_text"
            android:textSize="15sp"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_logo"/>
    </LinearLayout>
    <!-- Spacer: widgets can't inflate a plain View. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/cyc_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_primary"
        android:textSize="13sp"/>
    <TextView
        android:id="@+id/cyc_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="No cycle set"
        android:textColor="@color/widget_text"
        android:textSize="22sp"/>
    <TextView
        android:id="@+id/cyc_exercises"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Set one in Workout → Cycle"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"/>
</LinearLayout>
