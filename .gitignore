# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
apps/mobile/ios/
apps/mobile/android/
.superpowers/

# openGym exercise media: licensed by Gym visual for openGym only, never commit or publish
packages/catalogue/media/

# Hevy reference screenshots (contain other users' photos), local only
docs/hevy-screens/

# Design notes measured from Hevy screenshots, and AI planning notes: local only
docs/hevy-spec/
docs/superpowers/

# Editor settings
.idea/

# Build output of our local native modules
apps/mobile/modules/*/android/build/

# Scripts only the maintainer uses (release to their phone, desktop shortcut, perf tests)
apps/mobile/scripts/local/

# Test coverage report (pnpm test:coverage)
coverage/

# Turborepo cache
.turbo/

# Written by `expo start` in apps/mobile (expo-env.d.ts is already ignored above)
apps/mobile/.gitignore
