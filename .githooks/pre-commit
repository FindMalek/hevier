#!/usr/bin/env bash
# Runs before every commit: types, lint, tests, for every package (Turborepo
# skips the ones whose files didn't change). Turned on by `pnpm install` (the
# root "prepare" script sets git's core.hooksPath to .githooks).
# Skip once with `git commit --no-verify` (CI still runs the same checks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

printf '\n▶ Types, lint, tests (turbo)\n'
pnpm turbo run check

printf '\n✔ All checks passed\n'
