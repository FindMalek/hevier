{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "test"],
      "outputs": []
    }
  }
}
